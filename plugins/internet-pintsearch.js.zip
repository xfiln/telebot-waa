/*
const axios = require('axios');
const fs = require('fs');
const path = require('path');

// ------ Helpers yang bikin aman lintas platform (Telegraf/WA) ------
function getMessageId(msg) {
  return msg?.message_id
      ?? msg?.id
      ?? msg?.key?.id
      ?? msg?.message?.message_id
      ?? msg?.message?.id
      ?? msg?.message?.key?.id
      ?? null;
}

function getChatId(obj) {
  return obj?.chat?.id ?? obj?.chat ?? obj?.message?.chat?.id ?? null;
}

async function safeDelete(conn, chat, msgOrId) {
  const chatId = getChatId({ chat });
  const id = typeof msgOrId === 'string' || typeof msgOrId === 'number' ? msgOrId : getMessageId(msgOrId);
  if (!chatId || !id) return false;
  try {
    await conn.deleteMessage(chatId, id);
    return true;
  } catch (e) {
    return false;
  }
}

async function safeEditOrReply(conn, m, loadingMsg, text) {
  try {
    const chatId = getChatId(m);
    const msgId = getMessageId(loadingMsg);
    if (chatId && msgId && conn.editMessage) {
      await conn.editMessage(chatId, { message_id: msgId }, { text });
      return;
    }
  } catch {}
  try { await m.reply(text); } catch {}
}

// ----------------- Session store per chat -----------------
let pinterestSessions = {};

// ----------------- Pinterest API Functions -----------------
async function getPinterestMedia(url) {
  try {
    const apiUrl = `https://api.pinterest.com/url_resource/?url=${encodeURIComponent(url)}`;
    const response = await axios.get(apiUrl);
    
    if (response.data && response.data.resource_response) {
      const data = response.data.resource_response.data;
      return {
        title: data.title || 'Pinterest Media',
        description: data.description || '',
        image: data.images?.orig?.url || data.image_large_url,
        video: data.videos?.video_list?.V_720P?.url || data.story_pin_data?.pages?.[0]?.blocks?.[0]?.video?.video_list?.V_720P?.url
      };
    }
    throw new Error('Failed to fetch Pinterest data');
  } catch (err) {
    throw new Error('Pinterest API error: ' + err.message);
  }
}

async function downloadMedia(url, filename) {
  const filepath = path.join(__dirname, '../tmp', filename);
  try {
    const res = await axios.get(url, { responseType: 'stream' });
    await new Promise((resolve, reject) => {
      const writer = fs.createWriteStream(filepath);
      res.data.pipe(writer);
      writer.on('finish', resolve);
      writer.on('error', reject);
    });
    return filepath;
  } catch (err) {
    throw new Error('Download failed: ' + err.message);
  }
}

// ----------------- Handler utama -----------------
let handler = async (m, { conn, args, usedPrefix, command }) => {
  if (!args[0]) {
    return m.reply(`Usage: ${usedPrefix + command} <pinterest_url>`);
  }

  const url = args[0];
  if (!url.includes('pinterest.com') && !url.includes('pin.it')) {
    return m.reply('❌ Please provide a valid Pinterest URL');
  }

  const loadingMsg = await m.reply('📥 Fetching Pinterest media...');

  try {
    const media = await getPinterestMedia(url);
    const sessionId = Date.now().toString();
    
    pinterestSessions[sessionId] = {
      media,
      originalMessageId: getMessageId(m)
    };

    const buttons = [];
    if (media.image) {
      buttons.push([{ text: '🖼️ Download Image', callback_data: `pinterest_image_${sessionId}` }]);
    }
    if (media.video) {
      buttons.push([{ text: '🎥 Download Video', callback_data: `pinterest_video_${sessionId}` }]);
    }
    buttons.push([{ text: 'ℹ️ Info', callback_data: `pinterest_info_${sessionId}` }]);

    const caption = `📌 *Pinterest Media*\n\n📝 ${media.title}\n${media.description ? `\n${media.description.substring(0, 100)}...` : ''}`;

    const quotedParam = pinterestSessions[sessionId].originalMessageId 
      ? { message_id: pinterestSessions[sessionId].originalMessageId } 
      : {};

    await conn.sendButt(
      getChatId(m),
      caption,
      buttons,
      quotedParam
    );

    await safeDelete(conn, m.chat, loadingMsg);

  } catch (err) {
    console.error('[PINTEREST ERROR]:', err);
    await safeEditOrReply(conn, m, loadingMsg, `❌ Error: ${err.message}`);
  }
};

// ----------------- Callback Handler -----------------
handler.callback = async (ctx) => {
  const data = ctx?.callbackQuery?.data || ctx?.data;
  const conn = ctx.conn;
  
  if (!data || !data.startsWith('pinterest_')) {
    return false;
  }

  const parts = data.split('_');
  if (parts.length < 3) return false;
  
  const action = parts[1];
  const sessionId = parts[2];
  const session = pinterestSessions[sessionId];
  
  if (!session) {
    await ctx.answerCbQuery?.('❌ Session expired', { show_alert: true });
    return true;
  }

  try {
    const chatId = ctx?.callbackQuery?.message?.chat?.id || ctx?.message?.chat?.id;
    const quotedParam = session.originalMessageId ? { message_id: session.originalMessageId } : {};

    if (action === 'image' && session.media.image) {
      await ctx.answerCbQuery?.('📤 Sending image...');
      
      const filename = `pinterest_${sessionId}.jpg`;
      const filepath = await downloadMedia(session.media.image, filename);
      
      await conn.sendButt(
        chatId,
        `🖼️ *Pinterest Image*\n\n📝 ${session.media.title}`,
        [],
        quotedParam,
        { photo: { source: fs.createReadStream(filepath) } }
      );

      setTimeout(() => {
        try {
          if (fs.existsSync(filepath)) fs.unlinkSync(filepath);
        } catch {}
      }, 30000);

    } else if (action === 'video' && session.media.video) {
      await ctx.answerCbQuery?.('📤 Sending video...');
      
      const filename = `pinterest_${sessionId}.mp4`;
      const filepath = await downloadMedia(session.media.video, filename);
      
      await conn.sendButt(
        chatId,
        `🎥 *Pinterest Video*\n\n📝 ${session.media.title}`,
        [],
        quotedParam,
        { video: { source: fs.createReadStream(filepath) }, supports_streaming: true }
      );

      setTimeout(() => {
        try {
          if (fs.existsSync(filepath)) fs.unlinkSync(filepath);
        } catch {}
      }, 30000);

    } else if (action === 'info') {
      await ctx.answerCbQuery?.('ℹ️ Getting info...');
      
      const buttons = [];
      if (session.media.image) {
        buttons.push([{ text: '🖼️ Download Image', callback_data: `pinterest_image_${sessionId}` }]);
      }
      if (session.media.video) {
        buttons.push([{ text: '🎥 Download Video', callback_data: `pinterest_video_${sessionId}` }]);
      }

      await conn.sendButt(
        chatId,
        `📋 *Pinterest Info*\n\n📝 Title: ${session.media.title}\n\n${session.media.description}\n\n${session.media.image ? '✅ Image available\n' : ''}${session.media.video ? '✅ Video available' : ''}`,
        buttons,
        quotedParam
      );
    }
    
    return true;
    
  } catch (err) {
    console.error('[PINTEREST ERROR]:', err);
    try { await ctx.answerCbQuery?.('❌ Operation failed', { show_alert: true }); } catch {}
    return true;
  }
};

handler.help = ['pinterest <url>'];
handler.tags = ['downloader'];
handler.command = /^(pinterest|pin)$/i;

module.exports = handler;
*/

